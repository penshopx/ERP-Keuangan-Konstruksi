{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development SEED_DEMO_DATA=true && pnpm --filter @workspace/db run migrate && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "start:with-migrations": "pnpm --filter @workspace/db run setup && pnpm run start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=1 src/*.test.ts src/**/*.test.ts",
    "validate": "pnpm run typecheck && pnpm run test",
    "test:access": "tsx --test src/middlewares/access-policy.test.ts",
    "test:persistence": "tsx --test src/routes/persistence.integration.test.ts",
    "test:persistence-lock": "tsx --test src/testing/database-suite-lock.integration.test.ts",
    "test:fresh-database": "tsx --test src/fresh-database-startup.integration.test.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.67",
    "@clerk/shared": "^4.31.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
    ,"tsx": "catalog:"
  }
}

{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./operational-alert": {
      "types": "./src/operational-alert.d.ts",
      "default": "./src/operational-alert.mjs"
    }
  },
  "scripts": {
    "migrate": "node ./scripts/migrate.mjs",
    "setup": "pnpm run push && pnpm run migrate",
    "test": "node --test ./scripts/*.test.mjs",
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10"
  }
}
